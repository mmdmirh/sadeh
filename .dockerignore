# Exclude EVERYTHING by default
*
# Then explicitly include only what's needed
!app.py
!llm_service.py
!speech_service.py
!requirements.txt
!wait-for-db.sh
!static/css/**
!static/js/**
!templates/**
!migrations/**
!db/
!scripts/**
!deploy/**
# Still exclude large files/dirs even if in included directories
**/*.bin
**/*.gguf
**/*.pth
**/*.pt
**/__pycache__/

# Exclude RAG data, indexes, and uploads
rag_documents/
rag_indexes/
rag_uploads/
